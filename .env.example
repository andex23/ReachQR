# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Public URL used in emails and QR codes, e.g. https://reachqr.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key
# Must be a domain you've verified in Resend
EMAIL_FROM=ReachQR <hello@yourdomain.com>

# --- Admin dashboard (/admin) ---
ADMIN_PASSWORD=choose-a-long-random-password
# Optional extra secret mixed into admin session signatures
ADMIN_SESSION_SECRET=
